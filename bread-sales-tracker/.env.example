# ---- Copy this file to .env and fill in every value ----

# Your web address (point its DNS "A record" to this server's IP first), e.g. sales.mybakery.in
DOMAIN=sales.example.com

# Long random strings. Create them with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me-database-password
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# First admin login for the website (change the password later from Settings)
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-strong-password

BUSINESS_NAME=My Bakery
APP_TIMEZONE=Asia/Kolkata

# Optional: link where drivers can download the Android app (shown in the admin site)
APP_DOWNLOAD_URL=

# Minutes during which a driver may cancel their own bill (0 = never, only the owner can)
DRIVER_CANCEL_WINDOW_MINUTES=30

# Days of daily database backups to keep in ./backups
BACKUP_KEEP_DAYS=30

# Only set to false if you run WITHOUT https (e.g. testing on a local network)
COOKIE_SECURE=true
