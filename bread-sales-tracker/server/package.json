{
  "name": "bread-sales-server",
  "version": "1.0.0",
  "private": true,
  "description": "API for the Bread Sales app (driver app + admin website). Runs on Cloudflare Workers + D1, or on Node.js with SQLite.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "seed:demo": "tsx --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/scripts/seed-demo.ts",
    "restore": "tsx --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/scripts/restore-backup.ts",
    "cf:dev": "wrangler d1 migrations apply bread-sales --local && wrangler dev",
    "cf:deploy": "wrangler deploy",
    "build:site": "node cloudflare/build-site.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
